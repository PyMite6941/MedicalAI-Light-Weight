{
  "_comment": "MedicalAI - Light Weight configuration.",

  "device": "auto",
  "cpu_threads": "auto",
  "use_fp16": "auto",
  "use_onnx": true,

  "data_dir": "./data",
  "csv_path": "./data/dataset.csv",
  "images_dir": "./data/images",

  "checkpoint_dir": "./checkpoints",
  "onnx_dir": "./checkpoints/onnx",
  "onnx_full_dir": "./checkpoints/onnx_full",

  "blip_model_dir": "./blip-xray-finetuned",
  "blip_model_name": "Salesforce/blip-image-captioning-base",

  "fusion_checkpoint": "./checkpoints/fusion_model.pth",
  "fusion_labels": "./checkpoints/labels.json",

  "training": {
    "default_epochs": 10,
    "default_batch_size": 16,
    "default_lr": 0.0005,
    "default_grad_accum": 2,
    "default_val_split": 0.1,
    "classify_mode": "multilabel",
    "use_wider_head": false,
    "use_amp": true,
    "num_classes": 84
  },

  "cloud": {
    "project_id": "",
    "region": "us-central1",
    "bucket_name": "",
    "service_account": "",
    "machine_type": "n1-standard-16",
    "accelerator": "NVIDIA_TESLA_V100",
    "accelerator_count": 1,
    "worker_replicas": 1,
    "timeout_hours": 24,
    "data_prefix": "data/",
    "model_prefix": "models/"
  },

  "datasets": {
    "chexpert_max": 50000,
    "padchest_max": 40000,
    "vindr_max": 18000,
    "chexphoto_max": 10000,
    "siim_max": 12000,
    "rsna_max": 30000,
    "nih_full_max": 80000
  },

  "confidence_threshold": 0.75,
  "max_symptom_length": 64,
  "web_port": 7860,
  "web_host": "127.0.0.1",
  "api_port": 8000,
  "api_host": "127.0.0.1",
  "api_workers": 2
}